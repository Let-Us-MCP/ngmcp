{
  "name": "@churning_mcp/server",
  "version": "0.0.1",
  "description": "A stateless MCP server for core protocol 2026-07-28. No sessions, no initialize handshake, no runtime dependencies.",
  "license": "MIT",
  "author": "krimler <yavan@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Let-Us-MCP/ngmcp.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --test 'test/unit/*.test.js'",
    "test:it": "node --test 'test/integration/*.test.js'",
    "test:concurrency": "node --test 'test/concurrency/*.test.js'",
    "test": "npm run build && npm run test:unit && npm run test:it && npm run test:concurrency && npm run test:browser",
    "test:mutants": "node test/mutants.mjs",
    "test:browser": "node --test --test-timeout=60000 'test/browser/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "stateless",
    "2026-07-28"
  ],
  "publishConfig": {
    "access": "public"
  }
}
