{
  "name": "ngmcp",
  "version": "0.1.0",
  "description": "A stateless MCP Apps server framework for the 2026-07-28 protocol. No sessions, one typed contract from tool to view.",
  "license": "MIT",
  "author": "krimler <yavan@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Let-Us-MCP/ngmcp.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --test 'test/unit/*.test.js'",
    "test:it": "node --test 'test/integration/*.test.js'",
    "test:concurrency": "node --test 'test/concurrency/*.test.js'",
    "test": "npm run build && npm run test:unit && npm run test:it && npm run test:concurrency",
    "test:mutants": "node test/mutants.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "stateless",
    "2026-07-28"
  ]
}
